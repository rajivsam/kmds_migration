<owl:NamedIndividual rdf:about="#exploratoryobservation1">
  <rdf:type rdf:resource="#ExploratoryObservation"/>
  <finding rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The workflow uses the SBA loan dataset published through Data.gov to estimate charge-off risk and refer high-risk loans to human review. Implementation: notebooks/clean_sba_dataset.ipynb.</finding>
  <finding_sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</finding_sequence>
  <exploratory_observation_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Relevance Observation</exploratory_observation_type>
  <intent rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DATA_UNDERSTANDING</intent>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#exploratoryobservation2">
  <rdf:type rdf:resource="#ExploratoryObservation"/>
  <finding rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The evaluation population retains observed PIF and CHGOFF outcomes and excludes active EXEMPT, undisbursed COMMIT, and cancelled CANCLD records because their terminal outcomes are unavailable or not comparable.</finding>
  <finding_sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</finding_sequence>
  <exploratory_observation_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Data Quality Observation</exploratory_observation_type>
  <intent rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DATA_UNDERSTANDING</intent>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#exploratoryobservation3">
  <rdf:type rdf:resource="#ExploratoryObservation"/>
  <finding rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Charged-off loans are a minority class. Accuracy alone can therefore hide a weak screening queue, so ranking metrics and review-oriented gains, lift, precision, and recall are required.</finding>
  <finding_sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</finding_sequence>
  <exploratory_observation_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Data Quality Observation</exploratory_observation_type>
  <intent rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DATA_UNDERSTANDING</intent>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#datarepresentationobservation1">
  <rdf:type rdf:resource="#DataRepresentationObservation"/>
  <finding rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The final feature contract contains bankname, bankcity, initialinterestrate, bankstreet, and terminmonths. The feature set is a controlled five-feature judgment informed by the imbalanced feature screener; implementation: notebooks/sba_featurization.ipynb.</finding>
  <finding_sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</finding_sequence>
  <data_representation_observation_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Feature Engineering Observation</data_representation_observation_type>
  <intent rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FEATURE_ASSESSMENT</intent>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#datarepresentationobservation2">
  <rdf:type rdf:resource="#DataRepresentationObservation"/>
  <finding rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Geographic and clustered borrower features were investigated in notebooks/clustering_feature_derivation.ipynb, but the frozen modeling contract is limited to the five screened fields. Feature additions require a new controlled experiment.</finding>
  <finding_sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</finding_sequence>
  <data_representation_observation_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Feature Engineering Observation</data_representation_observation_type>
  <intent rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FEATURE_ASSESSMENT</intent>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#datarepresentationobservation3">
  <rdf:type rdf:resource="#DataRepresentationObservation"/>
  <finding rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Canonical 80/10/10 train, validation, and test assignments are persisted in dataset_partition and are never recreated inside modeling. Numeric median imputation and categorical M-estimate encoding are fit on train only and reused for validation and test.</finding>
  <finding_sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</finding_sequence>
  <data_representation_observation_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Data Transformation Observation</data_representation_observation_type>
  <intent rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FEATURE_ASSESSMENT</intent>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#modellingchoiceobservation1">
  <rdf:type rdf:resource="#ModellingChoiceObservation"/>
  <finding rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gradient Boosting and Random Forest are the candidate model families. Isotonic calibration is required to improve the probability ranking used for screening and cumulative-gains analysis.</finding>
  <finding_sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</finding_sequence>
  <modelling_choice_observation_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Modelling Choice Observation</modelling_choice_observation_type>
  <intent rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MODEL_EXPLANATION</intent>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#modellingchoiceobservation2">
  <rdf:type rdf:resource="#ModellingChoiceObservation"/>
  <finding rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The modeling formulation assumes the selected fields are available at decision time, a frozen train/validation/test contract represents the deployment ordering of information, and human review remains the final decision for referred loans.</finding>
  <finding_sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</finding_sequence>
  <modelling_choice_observation_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Modelling Assumption Observation</modelling_choice_observation_type>
  <intent rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MODEL_EXPLANATION</intent>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#modelselectionobservation1">
  <rdf:type rdf:resource="#ModelSelectionObservation"/>
  <finding rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Select the first-stage champion by validation PR-AUC, use validation only for the recall-first diagnostic and elbow cutoff, then apply the frozen model and cutoff once to test. Implementation: notebooks/sba_modeling.ipynb.</finding>
  <finding_sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</finding_sequence>
  <model_selection_observation_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Model Selection Statement</model_selection_observation_type>
  <intent rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MODEL_SELECTION</intent>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#modelselectionobservation2">
  <rdf:type rdf:resource="#ModelSelectionObservation"/>
  <finding rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The comparison setup uses the canonical partitions from data/featurization/model_ready_numeric_data.csv. Candidates are Gradient Boosting and Random Forest, probabilities receive isotonic calibration, validation PR-AUC drives champion selection, and test is not used for tuning.</finding>
  <finding_sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</finding_sequence>
  <model_selection_observation_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Model Selection Setup Description</model_selection_observation_type>
  <intent rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MODEL_SELECTION</intent>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#modelselectionobservation3">
  <rdf:type rdf:resource="#ModelSelectionObservation"/>
  <finding rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On validation, Gradient Boosting achieved PR-AUC 0.7560 and Random Forest achieved PR-AUC 0.7237. The broader feature set achieved validation PR-AUC 0.1673, evidence that candidate feature choice materially affects ranking quality.</finding>
  <finding_sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">11</finding_sequence>
  <model_selection_observation_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Model Selection Observation</model_selection_observation_type>
  <intent rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MODEL_SELECTION</intent>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#modelselectionobservation4">
  <rdf:type rdf:resource="#ModelSelectionObservation"/>
  <finding rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gradient Boosting was selected as the champion. The validation maximum-distance elbow selected the top 20.00% cohort and the frozen calibrated probability threshold 0.069643; score ties expanded the realized review population to 20.55% on validation.</finding>
  <finding_sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12</finding_sequence>
  <model_selection_observation_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Model Selection Result Summary</model_selection_observation_type>
  <intent rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MODEL_SELECTION</intent>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#experimentalobservation1">
  <rdf:type rdf:resource="#ExperimentalObservation"/>
  <finding rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hypothesis: selecting a compact, multi-perspective feature set will produce materially better probability ranking and a usable human-review queue than fitting on the broad, noisy feature universe.</finding>
  <finding_sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">13</finding_sequence>
  <experimental_observation_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hypothesis Statement</experimental_observation_type>
  <intent rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DATA_UNDERSTANDING</intent>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#experimentalobservation2">
  <rdf:type rdf:resource="#ExperimentalObservation"/>
  <finding rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The five-feature experiment increased test PR-AUC from 0.1523 to 0.7421, reduced the test review rate from 100.0% to 19.55%, and increased test lift from 1.00 to 4.22 relative to the prior broader feature set.</finding>
  <finding_sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">14</finding_sequence>
  <experimental_observation_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Experimental Observation</experimental_observation_type>
  <intent rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DATA_UNDERSTANDING</intent>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#experimentalobservation3">
  <rdf:type rdf:resource="#ExperimentalObservation"/>
  <finding rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The evidence supports the conjecture that redundant, sparse, correlated, or weakly measured fields obscure stable signal in an imbalanced dataset, while complementary feature-evaluation perspectives reduce dependence on one fitted classifier's importance scores.</finding>
  <finding_sequence rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">15</finding_sequence>
  <experimental_observation_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Experimental Conjecture</experimental_observation_type>
  <intent rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DATA_UNDERSTANDING</intent>
</owl:NamedIndividual>

